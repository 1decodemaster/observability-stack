# Copy to .env and edit. `docker compose` reads this automatically.

# Machine name — stamped onto every log stream and metric sample.
# Must be unique across the fleet.
MACHINE=pensive

# Server endpoints. Use a stable name (LAN DNS or Tailscale hostname) so
# moving the server later doesn't require touching clients.
SERVER_LOKI_URL=http://192.168.1.171:3100/loki/api/v1/push
SERVER_PROM_URL=http://192.168.1.171:9090/api/v1/write

# Optional exporters, comma-separated. node-exporter (host metrics) and
# cadvisor (container metrics) always run and are not listed here.
#   gpu    — NVIDIA GPU present            (dcgm-exporter; needs the NVIDIA
#            container toolkit installed on the host)
#   ras    — memory RAS via rasdaemon      (ras-exporter; needs `rasdaemon`
#            installed and running with --record)
#   smart  — SMART / NVMe disk health      (smartctl-exporter; privileged)
#
# This value is also passed to Alloy, which only creates scrape jobs for the
# exporters listed here — so a host without a GPU carries no permanent
# up{job="dcgm"}=0 series.
COMPOSE_PROFILES=ras,smart

# How often every local exporter is scraped. Keep at or below 15s: the
# dashboards and recording rules use rate(...[1m]) windows, which need at
# least two samples per minute to produce a value.
SCRAPE_INTERVAL=15s

# Where host logs come from:
#   auto     — use the systemd journal if this host has one, else fall back to
#              /var/log/syslog or /var/log/messages  (recommended)
#   journal  — force journald
#   file     — force the plaintext file, even if a journal exists
# Only ever one of the two: on Debian/Ubuntu, rsyslog writes the same records
# the journal already holds, so reading both would duplicate every line.
LOG_SOURCE=auto

# Override the dcgm-exporter image if you need a specific pinned tag
# (e.g. nvcr.io/nvidia/k8s/dcgm-exporter:3.3.9-3.6.1-ubuntu22.04).
#DCGM_IMAGE=nvidia/dcgm-exporter:latest

# LLM serving endpoints to scrape (up to 3; leave blank to disable).
# Addresses must be reachable from this machine; published host ports work
# via host-gateway, e.g. the llama.cpp server on port 8081:
LLM_TARGET_1=host.docker.internal:8081
LLM_TARGET_2=
LLM_TARGET_3=

# Docker container names of the LLM serving engine(s) (up to 3; leave blank
# to disable). Their log streams get role="serving" and are shown in the
# Model Inference dashboard's "Serving container logs" panel.
LLM_CONTAINER_1=llama-qwen
LLM_CONTAINER_2=
LLM_CONTAINER_3=
