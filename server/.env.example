# =============================================================================
# Metrics Stack - SERVER one-time environment
# -----------------------------------------------------------------------------
# Copy to `server/.env` and fill in ONCE. Docker compose reads `server/.env`
# automatically from the project directory on every `up` — the file lives on
# disk, so it survives reboots with no further setup.
#
#   cd server
#   cp .env.example .env
#   # edit .env (see comments below)
#   docker compose up -d     # recreates containers to pick up the new env
#
# NOTE: a plain `docker compose restart` does NOT re-read this file; use
# `docker compose up -d` after any change (it recreates only what changed,
# volumes are untouched).
# =============================================================================

# Grafana web UI admin (defaults admin/admin when unset or blank)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=

# Shared secret between grafana and the image renderer (PNG/PDF export).
# Set a strong value once; blank = the built-in "-" default on both sides
# (acceptable on a private LAN/tailnet only).
#   openssl rand -hex 32
GF_RENDERING_AUTH_TOKEN=
