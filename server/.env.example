# Copy to .env and edit. `docker compose` reads this automatically.

# Grafana admin credentials. There is no default — compose refuses to start
# without GF_ADMIN_PASSWORD, so the stack is never up with admin/admin.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me

# Prometheus retention. BOTH bounds apply, whichever is hit first.
# Size should leave headroom on the volume holding /var/lib/docker.
PROM_RETENTION_TIME=2160h
PROM_RETENTION_SIZE=50GB

# Enable optional server components, comma-separated:
#   pve — scrape Proxmox VE (requires pve/pve.yml + prometheus/targets/pve.json)
COMPOSE_PROFILES=
