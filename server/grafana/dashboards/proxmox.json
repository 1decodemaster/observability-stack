{
  "uid": "proxmox",
  "title": "Proxmox VE",
  "description": "Guest (VM/LXC) state and node/storage capacity from prometheus-pve-exporter. Requires the server `pve` profile: create server/pve/pve.yml and list the PVE node in server/prometheus/targets/pve.json.",
  "tags": [
    "metrics-stack"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
