      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(changes(container_start_time_seconds{machine=~\"$machine\",name!=\"\"}[1h])) or vector(0)",
