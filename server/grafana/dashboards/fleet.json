    {
      "type": "bargauge",
      "title": "Filesystem usage",
      "description": "Every real filesystem on every machine, worst first. FilesystemAlmostFull alerts at 90%.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{machine=~\"$machine\",fstype!~\"tmpfs|ramfs\"} / node_filesystem_size_bytes{machine=~\"$machine\",fstype!~\"tmpfs|ramfs\"})",
          "instant": false,
          "range": true,
          "legendFormat": "{{machine}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
