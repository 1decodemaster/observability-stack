          "uid": "Prometheus"
        },
        "query": {
          "query": "label_values(up, machine)",
          "refId": "machine-var"
        },
        "definition": "label_values(up, machine)",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "options": [],
        "current": {
          "selected": true,
